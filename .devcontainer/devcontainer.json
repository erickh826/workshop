{
  "name": "gemini-faculty-workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "pip install --no-cache-dir openai pandas matplotlib pyyaml",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.exclude": {
          "**/__pycache__": true
        },
        "editor.wordWrap": "on"
      },
      "extensions": [
        "ms-python.python",
        "ms-vscode.live-server"
      ]
    }
  }
}
