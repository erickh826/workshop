{
  "version": 2,
  "framework": null,
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/run",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}
