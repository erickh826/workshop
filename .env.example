# ==============================================================================
# Gemini Agent Harness 跨學科教學工作坊 — 雙通道 API 設定檔
# ==============================================================================
# 可選值：openrouter（工作坊預設） 或 poe（香港免 VPN 推薦）
ACTIVE_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 通道 A：OpenRouter 設定（課堂練習 / 跨模型實驗）
# 申請金鑰：https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# ------------------------------------------------------------------------------
# 通道 B：Poe API 設定（香港大專院校課後免 VPN 直連推薦）
# 申請金鑰：https://poe.com/api/keys
# ------------------------------------------------------------------------------
POE_BASE_URL=https://api.poe.com/v1
POE_MODEL=Gemini-3.1-Pro
POE_API_KEY=replace-with-your-poe-api-key
